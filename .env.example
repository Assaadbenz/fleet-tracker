# ==============================================================================
# Multi-Tenant Fleet & Maintenance Tracker - Environment Configuration
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker & Prisma)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fleet_admin
POSTGRES_PASSWORD=fleet_secret_password
POSTGRES_DB=fleet_db

# Prisma Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://fleet_admin:fleet_secret_password@localhost:5432/fleet_db?schema=public

# ------------------------------------------------------------------------------
# Redis & BullMQ Background Processing
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=fleet_redis_secret
REDIS_URL=redis://:fleet_redis_secret@localhost:6379
BULLMQ_PREFIX=fleet_queue

# ------------------------------------------------------------------------------
# Authentication & JWT Security (RBAC)
# ------------------------------------------------------------------------------
JWT_SECRET=super-secure-production-ready-jwt-secret-min-32-chars-fleet-auth
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secure-production-ready-refresh-secret-min-32-chars-fleet-refresh
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
