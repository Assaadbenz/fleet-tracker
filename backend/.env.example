# Application Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database & Prisma
DATABASE_URL=postgresql://fleet_admin:fleet_secret_password@localhost:5432/fleet_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=fleet_redis_secret
BULLMQ_PREFIX=fleet_queue

# Authentication & JWT
JWT_SECRET=super-secure-production-ready-jwt-secret-min-32-chars-fleet-auth
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secure-production-ready-refresh-secret-min-32-chars-fleet-refresh
JWT_REFRESH_EXPIRES_IN=7d
